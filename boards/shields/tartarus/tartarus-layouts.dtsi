#include <dt-bindings/zmk/keys.h>
#include <physical_layouts.dtsi>

/ {
    // Manually define the helper node to avoid "file not found" errors
//    key_physical_attrs: key_physical_attrs {
//        compatible = "zmk,key-physical-attrs";
//        #key-cells = <7>;
//    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Tartarus Layout";

        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys  //                    w    h     x     y      rot     rx     ry
            = <&key_physical_attrs 100 100     0     0       0      0      0> // 0
            , <&key_physical_attrs 100 100   100     0       0      0      0> // 1
            , <&key_physical_attrs 100 100   200     0       0      0      0> // 2
            , <&key_physical_attrs 100 100   300     0       0      0      0> // 3
            , <&key_physical_attrs 100 100   400     0       0      0      0> // 4
            , <&key_physical_attrs 100 100     0   100       0      0      0> // 5
            , <&key_physical_attrs 100 100   100   100       0      0      0> // 6
            , <&key_physical_attrs 100 100   200   100       0      0      0> // 7
            , <&key_physical_attrs 100 100   300   100       0      0      0> // 8
            , <&key_physical_attrs 100 100   400   100       0      0      0> // 9
            , <&key_physical_attrs 100 100     0   200       0      0      0> // 10
            , <&key_physical_attrs 100 100   100   200       0      0      0> // 11
            , <&key_physical_attrs 100 100   200   200       0      0      0> // 12
            , <&key_physical_attrs 100 100   300   200       0      0      0> // 13
            , <&key_physical_attrs 100 100   400   200       0      0      0> // 14
            , <&key_physical_attrs 100 100     0   300       0      0      0> // 15
            , <&key_physical_attrs 100 100   100   300       0      0      0> // 16
            , <&key_physical_attrs 100 100   200   300       0      0      0> // 17
            , <&key_physical_attrs 100 100   300   300       0      0      0> // 18
            , <&key_physical_attrs 100 200   400   300       0      0      0> // 19 (Scroll)
            , <&key_physical_attrs 100 100   500   300       0      0      0> // 20 (Thumb PCB)
            , <&key_physical_attrs 100 100   500   400       0      0      0> // 21 (Thumb Click)
            , <&key_physical_attrs 100 100   800   300       0      0      0> // 22 (W)
            , <&key_physical_attrs 100 100   700   400       0      0      0> // 23 (A)
            , <&key_physical_attrs 100 100   800   400       0      0      0> // 24 (S)
            , <&key_physical_attrs 100 100   900   400       0      0      0> // 25 (D)
            ;
    };
};